# Copy to .env for local development. The server reads the real process
# environment, so on a host these go in its own environment/secret settings.

# --- Required: where all data lives ---
# Project URL and the *service_role* key from Supabase → Settings → API.
# The service_role key bypasses row-level security: server-side only, never
# ship it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Required in production ---
# Signs session cookies. Any long random string; changing it logs everyone out.
SESSION_SECRET=

# Comma-separated list of the Google accounts allowed to sign in. Leave empty
# and ANYONE with a Google account can use the deployed app — and spend the AI
# credit below. Always set this on a public deployment.
ALLOWED_EMAILS=

# Public URL of the deployment, used for OAuth redirects and CORS. Both should
# be the same origin in the single-process setup.
WEB_ORIGIN=
API_ORIGIN=

# --- AI provider ---
# OpenRouter speaks the Anthropic Messages API, so the existing SDK works
# unchanged. Note there is no /v1 on the base URL — the SDK appends it.
# GEMINI_API_KEY must stay empty, or Gemini wins the provider check.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ENABLED=

# --- Sign-in ---
# Firebase project for browser-side Google sign-in. Falls back to
# firebase-applet-config.json when unset. Remember to add the deployed domain
# to the project's authorized domains, or the popup fails.
FIREBASE_PROJECT_ID=

# Optional server-side OAuth code flow, an alternative to the Firebase popup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Misc ---
MAX_UPLOAD_BYTES=
