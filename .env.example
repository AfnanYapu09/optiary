# Copy to .env and fill in. The server reads these from the process environment;
# `npm run dev` does not load .env automatically — export them or use a runner
# such as `dotenvx run -- npm run dev`.

# --- Server ---
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Where the SQLite database and uploaded screenshots live.
DATA_DIR=./data
# Required in production; generated and cached under DATA_DIR in development.
SESSION_SECRET=

# --- Google sign-in ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and add this exact redirect URI: ${API_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (Claude) ---
# Powers screenshot number-extraction and the research chatbot.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_ENABLED=true

# --- Development conveniences ---
# Local email sign-in without Google. Refused when NODE_ENV=production
# unless explicitly set to true.
ALLOW_DEV_LOGIN=true
MAX_UPLOAD_BYTES=12582912
